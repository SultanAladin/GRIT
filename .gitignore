# Unreal Engine .gitignore - Source Only

# Ignore everything by default
*

# Allow source code and config
!Source/
!Source/**
!Config/
!Config/**

# Allow Plugins source and descriptors
!Plugins/
!Plugins/*/
!Plugins/*/*.uplugin
!Plugins/*/Source/
!Plugins/*/Source/**

# Allow project files and scripts
!*.uproject
!*.code-workspace
!*.bat

# Allow .gitignore itself
!.gitignore

# Explicitly ignore Content and asset binaries
Content/
Content/**
*.uasset
*.umap

# Ignore binaries, build artifacts, and intermediate files
*.dll
*.exe
*.pdb
*.lib
*.a
*.so
*.dylib
*.exp
*.obj
Binaries/
*/Binaries/
*/*/Binaries/
Intermediate/
*/Intermediate/
*/*/Intermediate/
DerivedDataCache/
Saved/
.freebuff/

# Ignore Python cache & bytecode
__pycache__/
*.pyc
*.pyo

# Ignore web / prototype dependencies
node_modules/
dist/
